{
  "description": "guards — interactive Allow/Deny/Объясни gate on destructive Bash ops (git work-loss/hook-bypass + risky process kills), plus a Stop/SubagentStop guard that recovers Opus-4.8 dropped (namespaceless) tool calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-dispatch.sh guard-git-destructive-detect.py '🛡 Опасная git-операция'",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-dispatch.sh guard-process-kill-detect.py '🛡 Убийство процесса'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard-dropped-toolcall-detect.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard-dropped-toolcall-detect.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
